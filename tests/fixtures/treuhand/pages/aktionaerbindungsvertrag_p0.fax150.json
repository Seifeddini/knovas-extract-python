,[480.48,742.56,493.44,748.8,"Die",58.8,45,1,3],[498.72,739.68,503.52,753.6,"-",69.3,45,1,3],[504.48,742.56,534.72,748.8,"Parteien",94.1,45,1,3],[307.68,754.08,346.08,761.28,"behandeln",80.3,45,1,4],[355.68,754.08,368.64,761.28,"alle",80.3,45,1,4],[468.0,754.08,479.04,760.8,"die",80.4,45,1,4],[488.64,754.08,534.72,760.8,"Gesellschaft",77.2,45,1,4],[307.68,766.56,350.4,773.76,"vertraulich,",95.8,45,1,5],[353.76,767.04,371.04,773.76,"auch",96.1,45,1,5],[373.92,766.56,391.2,773.28,"nach",97.0,45,1,5],[394.08,766.56,439.68,775.2,"Beendigung",96.2,45,1,5],[442.56,766.56,465.12,773.28,"dieses",96.7,45,1,5],[468.0,766.56,506.4,775.2,"Vertrages.",71.6,45,1,5],[363.36,744.48,383.04,748.8,"einen",93.9,47,1,1],[378.72,754.08,432.0,760.8,"Informationen",91.5,49,1,1],[434.88,752.16,438.72,765.12,",",67.0,49,1,1],[442.08,754.08,458.4,760.8,"über",96.9,49,1,1],[225.12,806.88,305.76,813.6,"Aktonärbindungsvertrag",72.1,50,1,1],[308.64,806.88,328.8,812.16,"Müller",51.5,50,1,1],[331.2,806.4,341.28,812.16,"AG",48.1,50,1,1],[348.0,806.4,364.32,812.16,"Seite",75.5,50,1,1],[368.16,807.36,369.6,811.68,"1",94.4,50,1,1]],"rules":[["h",87.84,175.2,253.92,176.16],["h",264.0,175.2,350.4,175.68],["h",360.48,175.2,446.4,175.68],["h",453.6,175.2,534.72,175.68]],"plain_text":"Aktionärbindungsvertrag\n\nzwischen\n\nPeter Müller, geboren am 3. April 1961, von Zürich, wohnhaft in Küsnacht (nachfolgend «Partei 1»)\n\nSandra Müller-Weber, geboren am 19. November 1965. von Bern, wohnhaft in Küsnacht (nachfolgend\n\n«Partei 2»)\n\nThomas Brunner. geboren am 8. Februar 1972, von Luzern. wohnhaft in Zug (nachfolgend «Parici 3»)\n\nbetreffend die Müller AG mit Sitz in Zürich (CHE-123.456.789), nachfolgend «Gesellschaft»\n\nPräambel\nDie Parteien sind gemeinsam Eigentümer sämtlicher 500\nNamenaktien der Müller AG mit einem Nennwert von je\nCHF 1’000.00. Mit dem vorliegenden Vertrag wollen sie\ndie Köntinuität der Gesellschaft als Familienunternehmen\nsicherstellen und ihre Rechte und Pflichten als Aktionäre\nverbindlich regeln.\n\nArt. 1 Zweck\n\nDieser Vertrag bezweckt die einheitliche Ausübung der\nAktionirsrechte, die Sicherung einer - stabilen\nAktionärsstruktur sowie die Regelung der Übertragung von\nAktien unter den Parteien und an Dritte.\n\nArt. 2 Gegenstand des Vertrages\n\nDem Vertrag unterstehen alle Aktien, welche die Parteien\nheute halten oder künftig erwerben. insbesondere durch\nKapitalerhöhung, Erbgang, Schenkung oder Kauf. Die\nParteien halten die Aktien wie folge: Partei 1 260 Aktien,\nPartei 2 140 Aktien und Partei 3 100 Aktien.\n\nArt. 3 Stimmbindung\n\nDie Parteien verpflichten sich. ihr Stimmrecht an ‘der\nGeneralversammlung. einheitlich auszuüben. Vor jeder\nGeneralversammlung findet eine Vorbesprechung statt, an\nwelcher die Parteien mit einfacher Mehrheit der vertretenen\nAktienstimmen über die Stimmabgabe beschliessen\n\nBeschlüsse über die Änderung der Statuten, die Auflösung\nder Gesellschaft, die Ausschüttung von Dividenden von\nmehr als 40 % des Jahresgewinnes. sowie die Wahl des\nVerwaltungsrates bedürfen der Zustimmung - von\nmindestens zwei Dritteln der vertretenen Aktienstimmen.\n\nArt. 4 Vorkaufsrecht\n\nWill eine Partei Aktien ganz oder teilweise veräussern, so\nsteht den übrigen Parteien ein Vorkaufsrecht im Verhältnis\nihres bisherigen Aktienbesitzes zu, Die\nveräusserungswillige Partei hat die übrigen Parteien mit\neingeschriebenem Brief über. das Angebot des Dritten zu\ninformieren.\n\nDas Vorkaufsrecht ist innert 60 Tagen seit Empfang der\nMitteilung auszuüben. Der-Übernahmepreis entspricht dem\n\nVerkehrswert. der mangels. Einigung durch _ eine\nunabhängige © Treuhandgeseilschaft nach der\nPraktikermethode verbindlich festgelegt wird.\n\nArt. 5 Mitverkaufsrecht und Mitverkaufspflicht\n\nErhält eine Partei ein Angebot für mehr als 50 % aller\n\nAktien. so sind die übrigen Parteien berechtigt, ihre Aktien\nzu denselben Bedingungen Nehmen\nParteien, die zusammen mehr als zwei Drittel der Aktien\nhalten. ein solches Angebot an, so sind die übrigen Parteien\nverpflichtet, ihre Aktien ebenfalls zu verkaufen.\n\nmitzuverkaufen.\n\nArt. 6 Konkurrenzyerbot.\n\nWährend der Dauer dieses Vertrages und während zwei\nJahren nach dem Ausscheiden einer Partei ist es den\nParteien untersagt, sich direkt oder indirckt. an einem\nUnternehmen zu beteiligen. das mit der Gesellschaft im\nWettbewerb steht.\n\nArt: 7 Konventionalstrafe\n\nVerletzt eine Partei eine Bestimmung dieses Vertrages, so\nschuldet sie den übrigen ‘Parteien eine Konventionalstrafe\nvon CHF 250'000.00. Die Bezahlung der\nKonventionalstrafe befreit nicht von der Einhaltung des\nVertrages: weitergehender Schadenersatz bleibt\nvorbehalten.\n\nArt.8 Dauer und Kündigung\n\nDer Vertrag tritt mit der Unterzeichnung durch alle Parteien\nin Kraft und wird für eine feste Dauer von 20 Jahren\nabgeschlossen. Er verlängert sich jew\nJahre, sofern er nicht von einer Partei unter Einhaltung\n\num weitere fünf\n\neiner Frist von zwölf Monaten gekündigt wird.\n\nArt. 9 Anwendbares Recht und Gerichtsstand\n\nDieser Vertrag untersteht schweizerischem Recht.\nAusschliesslicher Gerichtsstand für alle Streitigkeiten aus\noder im Zusammenhang mit diesem Vertrag ist Zürich. Die\nParteien vorgängig\n\nSchlichtungsverfahren vor der Handelskammer.\n\nunterziehen sich einem\n\nArt. 10 Zusammensetzung des Verwaltungsrates\n\nDer Verwaltungsrät besteht aus drei Mitgliedern. Jede\nPartei-hat das Recht, ein Mitglied zur Wahl vorzuschlagen.\nund die übrigen Parteien verpflichten sich. für ‚die\nvorgeschlagene Person zu stimmen. Das Präsidium wird\ndurch Partei 1 gestellt. solange sie mindestens 30 % der\nAktien hält.\n\nArt. 11 Informationsrechte\n\nJede Partei erhält innert 90 Tagen nach Abschluss des\njahres die, geprüfte‘ Jahresrechnung. sowie\nhalbjährlich Zwischenabschluss. Die - Parteien\nbehandeln alle die Gesellschaft\nvertraulich, auch nach Beendigung dieses Vertrages.\n\neinen\n\nInformationen , über\n\nAktonärbindungsvertrag Müller AG Seite 1"}