{"doc":"aktionaerbindungsvertrag","page":1,"title":"Aktionärbindungsvertrag Müller AG","page_size":[595.28,841.89],"tables":[],"kvs":[],"headings":[{"text":"Art. 12 Schlussbestimmungen","level":2}],"items":[{"role":"heading","text":"Art. 12 Schlussbestimmungen","order":0,"bbox":[60.0,49.54,193.3,64.08]},{"role":"para","text":"Änderungen und Ergänzungen dieses Vertrages bedürfen","order":1,"bbox":[60.0,67.19,288.0,79.86]},{"role":"para","text":"der Schriftform und der Unterzeichnung durch alle","order":2,"bbox":[60.0,79.39,288.0,92.06]},{"role":"para","text":"Parteien. Sollte eine Bestimmung dieses Vertrages ungültig","order":3,"bbox":[60.0,91.59,288.0,104.26]},{"role":"para","text":"sein, so wird die Gültigkeit der übrigen Bestimmungen","order":4,"bbox":[60.0,103.79,288.0,116.46]},{"role":"para","text":"davon nicht berührt. Dieser Vertrag wird in drei","order":5,"bbox":[60.0,115.99,288.0,128.66]},{"role":"para","text":"Exemplaren ausgefertigt.","order":6,"bbox":[60.0,128.19,155.5,140.86]},{"role":"signature","text":"Küsnacht, 12. Juni 2023","order":7,"bbox":[60.0,160.46,156.94,173.8]},{"role":"signature","text":"Peter Müller","order":8,"bbox":[60.0,212.99,107.76,225.66]},{"role":"signature","text":"Sandra Müller-Weber","order":9,"bbox":[225.0,212.99,308.1,225.66]},{"role":"signature","text":"Thomas Brunner","order":10,"bbox":[390.0,212.99,454.12,225.66]},{"role":"footer","text":"Aktionärbindungsvertrag Müller AG · Seite 2","order":11,"bbox":[224.48,803.94,370.79,814.24]}],"ignore_regions":[]}